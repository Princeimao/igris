NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

HIVE_BASE_URL=http://localhost:8889

# ──────────────────────────────────────────────
# Optional: override Pi model provider
# Defaults to Nebius (OpenAI-compatible endpoint)
# ──────────────────────────────────────────────
# PI_MODEL_PROVIDER=nebius

# Memory backend: cognee (official Cognee TS SDK, default) or json (plain file).
# Cognee wiring: Gemini extracts the graph, local Ollama embeds vectors,
# LanceDB/kuzu files stay under ~/.igris/cognee. Telemetry disabled.
MEMORY_BACKEND=cognee
# Google AI Studio key (extraction LLM). Get one at https://aistudio.google.com
GEMINI_API_KEY=
# Optional overrides (sane local-first defaults apply when unset)
# COGNEE_LLM_MODEL=gemini-2.5-flash
# COGNEE_DATA_DIR=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Wake word ("Hey Igris", on-device Porcupine, no audio leaves this machine)
# 1. Create a free key at https://console.picovoice.ai
# 2. Train "Hey Igris" (English) and download the .ppn into desktop/public/porcupine/
# 3. Fill in both values below; without them, voice stays push-to-talk only.
# PORCUPINE_ACCESS_KEY=
# VITE_PORCUPINE_KEYWORD_URL=/porcupine/hey-igris.ppn
